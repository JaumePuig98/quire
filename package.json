{
  "name": "quire",
  "productName": "Quire",
  "version": "0.2.0",
  "description": "A distraction-free, typewriter-style writing app for books",
  "main": "main.js",
  "author": "Jaume Puig Costa-Jussà",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "app.writingapp.editor",
    "productName": "Quire",
    "files": [
      "main.js",
      "preload.js",
      "exporters.js",
      "shared/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "draft",
        "name": "Draft document",
        "description": "Draft document",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Quire-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JaumePuig98",
        "repo": "quire",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Quire-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "docx": "^9.16.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaumePuig98/quire.git"
  },
  "homepage": "https://github.com/JaumePuig98/quire"
}
