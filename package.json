{
  "name": "quire",
  "productName": "Quire",
  "version": "1.5.4",
  "description": "A distraction-free, typewriter-style writing app for books",
  "main": "main.js",
  "desktopName": "quire.desktop",
  "author": "Jaume Puig Costa-Jussà",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "test:e2e": "node test/e2e.js"
  },
  "build": {
    "appId": "app.writingapp.editor",
    "productName": "Quire",
    "files": [
      "main.js",
      "preload.js",
      "exporters.js",
      "epub.js",
      "docx-import.js",
      "shared/**/*",
      "renderer/**/*",
      "exporter-fonts/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "draft",
        "name": "Draft document",
        "description": "Draft document",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "Quire-${version}-${arch}.${ext}",
      "synopsis": "A quiet typewriter-style writing app",
      "executableName": "quire"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Quire-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JaumePuig98",
        "repo": "quire",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Quire-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "docx": "^9.16.0",
    "electron-updater": "^6.8.11",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaumePuig98/quire.git"
  },
  "homepage": "https://github.com/JaumePuig98/quire"
}
