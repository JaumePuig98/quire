{
  "name": "quire",
  "productName": "Quire",
  "version": "0.1.1",
  "description": "A distraction-free, typewriter-style writing app for books",
  "main": "main.js",
  "author": "Jaume Puig Costa-Jussà",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run.js",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "app.writingapp.editor",
    "productName": "Quire",
    "files": [
      "main.js",
      "preload.js",
      "exporters.js",
      "shared/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "draft",
        "name": "Draft document",
        "description": "Draft document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "docx": "^9.16.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/inter": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaumePuig98/quire.git"
  },
  "homepage": "https://github.com/JaumePuig98/quire"
}
